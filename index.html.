
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080808">
<title>Nexora Studios</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #080808;
  color: white;
  font-family: Arial, sans-serif;
  min-height: 100vh;
}

header {
  padding: 25px;
  border-bottom: 1px solid #302719;
  text-align: center;
}

.logo {
  color: #d8b56b;
  font-size: 23px;
  font-weight: bold;
  letter-spacing: 5px;
}

main {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 25px;
}

.symbol {
  width: 85px;
  height: 85px;
  border: 1px solid #d8b56b;
  border-radius: 22px;
  display: grid;
  place-items: center;
  color: #d8b56b;
  font-size: 38px;
  margin-bottom: 30px;
  box-shadow: 0 0 30px #d8b56b30;
}

h1 {
  color: #e3c47f;
  font-size: 38px;
  letter-spacing: 4px;
  margin-bottom: 12px;
}

.subtitle {
  color: #a88b55;
  font-size: 12px;
  letter-spacing: 5px;
  margin-bottom: 30px;
}

.description {
  color: #999;
  font-size: 14px;
  line-height: 1.8;
  max-width: 300px;
  margin-bottom: 35px;
}

button {
  background: linear-gradient(135deg, #e6c77e, #a77b35);
  color: #080808;
  border: none;
  padding: 17px 35px;
  border-radius: 8px;
  font-weight: bold;
  letter-spacing: 2px;
  cursor: pointer;
}

#mensagem {
  color: #d8b56b;
  margin-top: 25px;
  font-size: 13px;
}

footer {
  text-align: center;
  padding: 25px;
  color: #766344;
  font-size: 11px;
  letter-spacing: 2px;
}
</style>
</head>

<body>

<header>
  <div class="logo">NEXORA STUDIOS</div>
</header>

<main>
  <div class="symbol">N</div>

  <h1>NEXORA</h1>
  <div class="subtitle">STUDIOS</div>

  <p class="description">
    Criatividade, tecnologia e inovação.
    Transformando ideias em experiências digitais.
  </p>

  <button onclick="iniciar()">COMEÇAR AGORA</button>

  <p id="mensagem"></p>
</main>

<footer>
  NEXORA STUDIOS © 2026
</footer>

<script>
function iniciar() {
  document.getElementById("mensagem").textContent =
    "Bem-vindo à Nexora Studios.";
}
</script>

</body>
</html>